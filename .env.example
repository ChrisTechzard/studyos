# StudyOS environment variables (ground stage)
# Copy to .env.local for local development.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Auth (required for sign-in)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PostgreSQL (required for study data)
# Pooler URL is fine with [YOUR-PASSWORD] left in place; the app injects DATABASE_PASSWORD.
DATABASE_URL=
# Your raw database password. Do not URL-encode it here.
DATABASE_PASSWORD=
# Set to require when connecting to Supabase over TLS
# DATABASE_SSL=require
# Path to the Supabase root CA used to verify TLS (defaults to certs/prod-ca-2021.crt)
# DATABASE_CA_PATH=

# Object storage (planned)
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=

# AI provider abstraction (planned)
# AI_PROVIDER=
# AI_API_KEY=

# Realtime / Live rooms (planned)
# REALTIME_PROVIDER=
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
